# =============================================================================
# Bot IA HubSpot — Configuración de Entorno
# =============================================================================
# Copia este archivo como .env y ajusta los valores según tu entorno.
#   cp .env.example .env
# =============================================================================

# ---- Server ----
PORT=3090
NODE_ENV=development
LOG_LEVEL=debug
CORS_ORIGIN=*

# ---- PostgreSQL ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hubspot_bot
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10

# ---- Ollama (Local LLM) ----
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1024

# ---- HubSpot ----
# Crea un Private App Token en Settings > Integrations > Private Apps
# Scopes requeridos: crm.objects.contacts.write, crm.objects.contacts.read, crm.objects.deals.write
HUBSPOT_ACCESS_TOKEN=

# ---- WhatsApp ----
# Driver: 'webjs' (whatsapp-web.js, requiere Chromium) o 'meta' (Meta Business API)
WHATSAPP_DRIVER=webjs
WHATSAPP_SESSION_PATH=./whatsapp-session

# Meta WhatsApp Business API (requiere WHATSAPP_DRIVER=meta)
# Configurar en Meta Business > WhatsApp > API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=bot-verify-token

# ---- Business ----
BUSINESS_NAME=NeoWeb Studio
BUSINESS_SERVICES=Desarrollo web, landing pages, automatización de procesos

# ---- Webhook ----
# Si se define, el webhook /api/webhook requerirá firma HMAC-SHA256 en header X-Webhook-Signature
# El widget embebible debe incluir data-webhook-secret="valor" en el script tag
WEBHOOK_SECRET=

# ---- Dashboard ----
# Dejar vacío para deshabilitar autenticación
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
